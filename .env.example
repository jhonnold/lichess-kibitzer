# Copy to .env (production: /opt/lichess-kibitzer/.env, read by systemd's EnvironmentFile;
# the app itself does not load .env). One VAR=value per line, no quotes. Avoid ", ' and \ in values:
# systemd strips quotes and processes backslashes, unlike a shell.

# HTTP port; binds all interfaces. Default 8080.
PORT=8080

# Admin page password. Unset or empty: every login is refused.
ADMIN_PASSWORD=

# Persisted state (picked Board, engine config, evals). Default data/state.json, relative to the working dir.
# Production: inside the unit's StateDirectory.
DATA_FILE=/var/lib/lichess-kibitzer/state.json

# Engine path prefilled on the Admin page (with Threads=1, Hash=1024). Default `berserk`, looked up on PATH.
DEFAULT_ENGINE=/usr/local/bin/berserk
